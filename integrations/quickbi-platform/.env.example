# Variables are read from the process environment; .env is NOT auto-loaded.
HOST=127.0.0.1
PORT=3088
DB_PATH=./data/quickbi.sqlite
DEMO_MODE=0
BOOTSTRAP_EMAIL=admin@example.org
BOOTSTRAP_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Required for any real DB source: openssl rand -hex 32
DATASOURCE_MASTER_KEY=REPLACE_WITH_64_HEX_DIGITS
# Exact hostname/IP allowlist (NO wildcard). Internal DB hosts allowed when explicitly listed.
DATASOURCE_ALLOWED_HOSTS=database.internal,127.0.0.1
# Optional; requires compatible DeepSeek Harness SDK, model credentials, isolated execution environment
HARNESS_ENABLE=0
# Use native bi_catalog / bi_query, rather than the older JSON planner (requires SDK/API key)
HARNESS_AGENT_MODE=disabled
DEEPSEEK_API_KEY=REPLACE_WITH_API_KEY
HARNESS_HOME=./data/harness
NODE_ENV=development

# Recurring AIPro analysis; run only one active Node instance
SCHEDULE_WORKER_ENABLED=1

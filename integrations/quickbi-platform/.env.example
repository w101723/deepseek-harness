# Copy to .env and export variables before starting; server does NOT automatically load .env
PORT=3088
HOST=127.0.0.1
DB_PATH=./data/quickbi.sqlite
# One-time bootstrap; do not set DEMO_MODE in production
DEMO_MODE=0
BOOTSTRAP_EMAIL=admin@example.org
BOOTSTRAP_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Opt-in isolated Harness SDK narration; requires @deepseek-ai/dsh-sdk-client & configured provider
HARNESS_ENABLE=0
HARNESS_HOME=./data/harness
NODE_ENV=development